{
  "name": "tend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build --turbopack",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run --project unit",
    "test:ui": "vitest run --project ui",
    "typecheck": "tsc --noEmit",
    "check": "pnpm typecheck && pnpm lint && pnpm test",
    "seed:build": "tsx supabase/seed/build.ts",
    "ai:smoke": "tsx scripts/ai-smoke.ts",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:seed": "tsx --env-file=.env.local scripts/db-seed.ts",
    "db:reset": "supabase db reset && pnpm db:seed",
    "db:reset:blank": "supabase db reset && tsx --env-file=.env.local scripts/db-seed.ts --blank",
    "db:remote": "tsx --env-file=.env.local scripts/db-remote.ts",
    "user:reset-password": "tsx --env-file=.env.local scripts/reset-password.ts",
    "e2e": "playwright test --project=desktop && playwright test --project=mobile"
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.109",
    "@mediapipe/tasks-vision": "0.10.21",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.0",
    "@tanstack/react-query": "^5.106.0",
    "ai": "^7.0.163",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.5.2",
    "lucide-react": "^1.68.0",
    "next": "15.5.29",
    "next-intl": "^4.14.9",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.8.1",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "recharts": "^3.10.1",
    "server-only": "^0.0.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "@electric-sql/pglite": "^0.5.15",
    "@electric-sql/pglite-pgvector": "0.0.16",
    "@eslint/eslintrc": "^3",
    "@playwright/test": "1.56.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.2.1",
    "eslint": "^9",
    "eslint-config-next": "15.5.29",
    "jsdom": "^30.1.3",
    "postgres": "^4.0.0",
    "shadcn": "^4.23.0",
    "supabase": "^3.0.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^5.1.0"
  }
}
