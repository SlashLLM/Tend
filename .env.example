# ── Supabase (Singapore region: ap-southeast-1) ──
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Bypasses RLS — used by the AI pipeline, ai_run logging and demo sign-in.
SUPABASE_SERVICE_ROLE_KEY=

# Public origin used in magic-link emails (optional; defaults to the request host)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── AI: GPT-6 Luna via OpenAI ──
OPENAI_API_KEY=
# Optional: point at an in-region deployment once Singapore residency is confirmed (PRD Q4)
OPENAI_BASE_URL=
# Recorded on every ai_run row for the residency audit trail
AI_REGION=unconfirmed
# Per-task model overrides, e.g. if the Day-4 quality gate fails:
# AI_MODEL_FEEDBACK_WRITE=gpt-6-sol

# ── Demo ──
# 1 = show the persona switcher on /login (synthetic @demo.tend.sg accounts only)
DEMO_MODE=1

# Vercel cron auth for /api/cron/catalogue-sync (monthly programmes sync). Any long random string.
CRON_SECRET=
